MONGODB_URI=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# US15 — Google Places (same key). Enable billing + either “Places API (New)” OR
# classic “Places API” in the key’s GCP project. The app tries New API, then legacy.
# https://developers.google.com/maps/documentation/places/web-service/get-api-key
GOOGLE_MAPS_API_KEY=

# US16 — Expedia Group Rapid (optional). Lodging property IDs only; otherwise the
# app uses Expedia Hotel Search for the destination.
# https://developers.expediagroup.com/rapid/setup
EXPEDIA_RAPID_API_KEY=
EXPEDIA_RAPID_SECRET=
# Optional; default is Rapid test host
EXPEDIA_RAPID_BASE_URL=https://test.ean.com

# Unsplash image search for dashboard group cards.
UNSPLASH_ACCESS_KEY=

# Spark / local Ollama (itinerary generation). Docker dev image runs ollama inside the app container.
# Host-only dev: run `ollama serve`, then `ollama pull` the same tag as OLLAMA_MODEL.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
# Set to 1 in tests/CI to skip Ollama (stub itineraries).
# OLLAMA_SKIP=0
