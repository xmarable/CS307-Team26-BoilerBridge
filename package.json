  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --config=jest.config.cjs --runInBand --forceExit --colors --verbose 2>&1 | grep -v 'Force exiting Jest'",
