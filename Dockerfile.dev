FROM node:22-slim

# add zstd here so the ollama installer can actually unpack itself
RUN apt-get update && apt-get install -y \
    curl \
    procps \
    zstd \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# now the install script will work
RUN curl -fsSL https://ollama.com/install.sh | sh

WORKDIR /workspaces/CS307-Team26-BoilerBridge

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

# Wait for Ollama, then pull the default small model so /api/chat does not 404 on first use.
# Override with OLLAMA_MODEL in docker-compose or .env.local.
CMD ["sh", "-c", "ollama serve & sleep 2; i=0; while [ \"$i\" -lt 45 ]; do curl -sf http://127.0.0.1:11434/api/tags >/dev/null && break; i=$((i+1)); sleep 1; done; ollama pull \"${OLLAMA_MODEL:-llama3.2:1b}\" || echo \"[ollama] model pull failed; run: ollama pull ${OLLAMA_MODEL:-llama3.2:1b}\"; exec npm run dev"]