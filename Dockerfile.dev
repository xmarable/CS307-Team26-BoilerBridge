FROM node:22-slim

# add zstd here so the ollama installer can actually unpack itself
RUN apt-get update && apt-get install -y \
    curl \
    procps \
    zstd \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# now the install script will work
RUN curl -fsSL https://ollama.com/install.sh | sh

WORKDIR /workspaces/CS307-Team26-BoilerBridge

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

CMD ["sh", "-c", "ollama serve & sleep 5 && npm run dev || tail -f /dev/null"]